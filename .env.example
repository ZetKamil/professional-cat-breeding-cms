APP_NAME="Hodowla Kotów z Mazowieckiej Szwajcarii"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://kotyzmazowieckiejszwajcarii.pl

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ============================================================
# LOGGING — production: error level only
# ============================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================================
# DATABASE — MySQL (OVH)
# ============================================================
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ============================================================
# SESSION — database driver (requires sessions table in DB)
# ============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ============================================================
# CACHE — database driver (requires cache table in DB)
# ============================================================
CACHE_STORE=database

# ============================================================
# QUEUE — sync (no queue worker required on shared hosting)
# Prevents contact form emails from being silently discarded.
# ============================================================
QUEUE_CONNECTION=sync

# ============================================================
# FILESYSTEM — public disk (storage/app/public → public/storage)
# ============================================================
FILESYSTEM_DISK=public

BROADCAST_CONNECTION=log

# ============================================================
# MAIL — SMTP
# ============================================================
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=biuro@kotyzmazowieckiejszwajcarii.pl
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# GOOGLE ANALYTICS 4
# ============================================================
GOOGLE_ANALYTICS_ID=

# ============================================================
# VITE
# ============================================================
VITE_APP_NAME="${APP_NAME}"
